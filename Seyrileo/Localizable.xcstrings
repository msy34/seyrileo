    "Check Wi-Fi or mobile data and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من Wi‑Fi أو بيانات الجوال وحاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Provjerite Wi‑Fi ili mobilne podatke i pokušajte ponovo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe WLAN oder mobile Daten und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez le Wi‑Fi ou les données mobiles et réessayez."
          }
        },
        "ru": {
          "stringUnit": {

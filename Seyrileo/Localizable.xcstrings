    },
    "Check the address, including any port or path your provider gave you.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من العنوان بما في ذلك المنفذ أو المسار الذي أعطاك إياه المزوّد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Provjerite adresu, uključujući port ili putanju koju vam je dao pružatelj."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe die Adresse inklusive Port oder Pfad, die dein Anbieter angegeben hat."
          }
        },
        "fr": {

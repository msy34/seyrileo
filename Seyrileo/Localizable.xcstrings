        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo streamovi dolaze samo s ovog telefona; AirPlay prijemnik ih ne može dosegnuti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo-Streams kommen nur von diesem Telefon; ein AirPlay-Empfänger kann sie nicht erreichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les flux de démonstration sont servis uniquement depuis ce téléphone ; un récepteur AirPlay ne peut pas les atteindre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Демо-потоки передаются только с этого телефона; приёмник AirPlay не может до них добраться."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Örnek yayınlar yalnızca bu telefondan sunulur; AirPlay alıcısı bunlara erişemez."
          }
        }
      }

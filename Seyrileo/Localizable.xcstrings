            "value": "Program rehberi"
          }
        }
      }
    },
    "Tap a source to make it active. Swipe to remove it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على مصدر لتفعيله. اسحب لإزالته."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite izvor da ga aktivirate. Prevucite da ga uklonite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eine Quelle, um sie zu aktivieren. Wische, um sie zu entfernen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une source pour l’activer. Balayez pour la supprimer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь источника, чтобы сделать его активным. Смахните, чтобы удалить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinleştirmek için bir kaynağa dokun. Kaldırmak için kaydır."
          }
        }
      }
    },
    "Test & Save": {
      "localizations": {

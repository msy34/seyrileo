    "AirPlay device selected: %@. Video is not playing on it yet.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم اختيار جهاز AirPlay: %@. لم يبدأ تشغيل الفيديو عليه بعد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odabran je AirPlay uređaj: %@. Video se na njemu još ne reproducira."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay-Gerät ausgewählt: %@. Das Video wird dort noch nicht abgespielt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appareil AirPlay sélectionné : %@. La vidéo n’y est pas encore lue."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбрано устройство AirPlay: %@. Видео на нём ещё не воспроизводится."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay cihazı seçildi: %@. Görüntü henüz bu cihazda oynatılmıyor."
          }
        }
      }
    },

    "You can keep up to %lld reminders at a time.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك الاحتفاظ بـ %lld تذكير كحد أقصى في الوقت نفسه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Istovremeno možete imati najviše %lld podsjetnika."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst bis zu %lld Erinnerungen gleichzeitig haben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez garder jusqu’à %lld rappels à la fois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одновременно можно хранить не более %lld напоминаний."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı anda en fazla %lld hatırlatma tutabilirsin."
          }
        }
      }
    },
    "You're notified 5 minutes before the programme starts. Reminders for locked channels don't show the channel or programme name.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يصلك إشعار قبل بدء البرنامج بخمس دقائق. لا تعرض تذكيرات القنوات المقفلة اسم القناة أو البرنامج."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obavještenje dobijate 5 minuta prije početka programa. Podsjetnici za zaključane kanale ne prikazuju naziv kanala ni programa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wirst 5 Minuten vor Beginn der Sendung benachrichtigt. Erinnerungen für gesperrte Sender zeigen weder Sender noch Sendung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes averti 5 minutes avant le début du programme. Les rappels des chaînes verrouillées n’affichent ni la chaîne ni le programme."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомление придёт за 5 минут до начала передачи. Напоминания для заблокированных каналов не показывают ни канал, ни передачу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Program başlamadan 5 dakika önce bildirim alırsın. Kilitli kanallardaki hatırlatmalar kanal ya da program adını göstermez."
          }
        }
      }
    },

    "%lld channels have programme information.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لدى %lld قناة معلومات البرامج."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld kanala ima informacije o programu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Sender haben Programminformationen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld chaînes ont des informations de programme."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У %lld каналов есть программа передач."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld kanalın program bilgisi var."
          }
        }
      }
    },
    "%lld entries from the provider could not be read and were skipped.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة %lld من إدخالات المزوّد وتم تخطيها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld unosa od pružatelja nije moglo biti pročitano i preskočeno je."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Einträge des Anbieters konnten nicht gelesen werden und wurden übersprungen."
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld entry from the provider could not be read and was skipped."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld entries from the provider could not be read and were skipped."
                }
              }
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld entrées du fournisseur n’ont pas pu être lues et ont été ignorées."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записей поставщика, которые не удалось прочитать и которые были пропущены: %lld."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlayıcıdan gelen %lld kayıt okunamadı ve atlandı."
          }
        }
      }
    },
    "%lld movies · %lld series · updated %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld فيلم · %lld مسلسل · تم التحديث %@"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld filmova · %lld serija · ažurirano %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Filme · %lld Serien · aktualisiert %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld films · %lld séries · mis à jour %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фильмов: %lld · сериалов: %lld · обновлено %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld film · %2$lld dizi · %3$@ güncellendi"
          }
        }
      }
    },
    "1. Open Control Center (swipe down from the top-right corner).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "١. افتح مركز التحكم (اسحب لأسفل من الزاوية العلوية اليمنى)."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Otvorite Kontrolni centar (prevucite prema dolje iz gornjeg desnog ugla)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Öffne das Kontrollzentrum (von der oberen rechten Ecke nach unten wischen)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Ouvrez le Centre de contrôle (balayez vers le bas depuis le coin supérieur droit)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Откройте Пункт управления (смахните вниз от правого верхнего угла)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Denetim Merkezi'ni aç (sağ üst köşeden aşağı kaydır)."
          }
        }
      }
    },
    "2. Tap Screen Mirroring.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "٢. اضغط على «انعكاس الشاشة»."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Dodirnite Preslikavanje ekrana."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Tippe auf „Bildschirmsynchronisierung“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Touchez Recopie de l’écran."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Коснитесь «Повтор экрана»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Ekran Yansıtma'ya dokun."
          }
        }
      }
    },
    "3. Choose your TV or Apple TV.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "٣. اختر التلفاز أو Apple TV."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Odaberite televizor ili Apple TV."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Wähle deinen Fernseher oder dein Apple TV."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Choisissez votre téléviseur ou Apple TV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Выберите телевизор или Apple TV."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "3. TV'ni veya Apple TV'ni seç."
          }
        }
      }
    },

    "Reminders can only be set for programmes that haven't started yet.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن ضبط التذكير إلا للبرامج التي لم تبدأ بعد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podsjetnik se može postaviti samo za programe koji još nisu počeli."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen sind nur für Sendungen möglich, die noch nicht begonnen haben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels ne peuvent être créés que pour des programmes qui n’ont pas encore commencé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминание можно поставить только для передач, которые ещё не начались."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatırlatma yalnızca henüz başlamamış programlar için kurulabilir."
          }
        }
      }
    },

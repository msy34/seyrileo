    "Swipe left on a channel, or touch and hold it, to add it to your favorites.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب قناة إلى اليسار أو المسها مطولًا لإضافتها إلى المفضلة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevucite kanal ulijevo ili ga dodirnite i držite da ga dodate u favorite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische auf einem Sender nach links oder halte ihn gedrückt, um ihn zu den Favoriten hinzuzufügen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez une chaîne vers la gauche, ou touchez-la longuement, pour l’ajouter à vos favoris."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смахните канал влево или нажмите и удерживайте его, чтобы добавить в избранное."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kanalı favorilere eklemek için sola kaydır ya da basılı tut."
          }
        }
      }
    },
    "Synthetic test patterns served from this device. These are not real channels.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنماط اختبار اصطناعية تُبث من هذا الجهاز. ليست قنوات حقيقية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sintetički testni uzorci koje šalje ovaj uređaj. To nisu pravi kanali."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synthetische Testbilder, die von diesem Gerät gesendet werden. Das sind keine echten Sender."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mires de test synthétiques servies depuis cet appareil. Ce ne sont pas de vraies chaînes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синтетические тестовые таблицы с этого устройства. Это не настоящие каналы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazdan sunulan yapay test desenleri. Bunlar gerçek kanallar değildir."
          }
        }
      }
    },
    "TV connected. The video is shown on the TV in full screen.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم توصيل التلفاز. يُعرض الفيديو على التلفاز بملء الشاشة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Televizor je povezan. Video se prikazuje preko cijelog ekrana televizora."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fernseher verbunden. Das Video wird im Vollbild auf dem Fernseher gezeigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléviseur connecté. La vidéo s’affiche en plein écran sur le téléviseur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телевизор подключён. Видео показывается на телевизоре на весь экран."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV bağlı. Video TV'de tam ekran gösteriliyor."
          }
        }
      }
    },
    "TV guide": {
      "localizations": {
        "ar": {
          "stringUnit": {

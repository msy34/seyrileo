    "Seyrileo can't remind you about programmes without notifications.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع Seyrileo تذكيرك بالبرامج دون إشعارات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Seyrileo vas ne može podsjetiti na programe bez obavještenja."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Mitteilungen kann Seyrileo dich nicht an Sendungen erinnern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seyrileo ne peut pas vous rappeler les programmes sans notifications."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без уведомлений Seyrileo не сможет напоминать о передачах."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seyrileo bildirimler olmadan programları hatırlatamaz."
          }
        }
      }
    },
    "Seyrileo couldn't open its data": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على Seyrileo فتح بياناته"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Seyrileo nije mogao otvoriti svoje podatke"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seyrileo konnte seine Daten nicht öffnen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seyrileo n’a pas pu ouvrir ses données"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Seyrileo не удалось открыть свои данные"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seyrileo verilerini açamadı"
          }
        }
      }
    },
    "Seyrileo is a media player. It doesn't provide channels, subscriptions or content.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Seyrileo مشغّل وسائط. لا يقدّم قنوات أو اشتراكات أو محتوى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Seyrileo je medijski plejer. Ne pruža kanale, pretplate ni sadržaj."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seyrileo ist ein Mediaplayer. Es stellt keine Sender, Abos oder Inhalte bereit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seyrileo est un lecteur multimédia. Il ne fournit ni chaînes, ni abonnements, ni contenus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Seyrileo — это медиаплеер. Он не предоставляет каналы, подписки или контент."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seyrileo bir medya oynatıcıdır. Kanal, abonelik veya içerik sağlamaz."
          }
        }
      }
    },
    "Seyrileo is a player. It doesn't sell or include any channels. Add a source you're authorized to use.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Seyrileo مشغّل. لا يبيع أي قنوات ولا يتضمنها. أضف مصدرًا مصرّحًا لك باستخدامه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Seyrileo je plejer. Ne prodaje i ne sadrži kanale. Dodajte izvor koji smijete koristiti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seyrileo ist ein Player. Es verkauft oder enthält keine Sender. Füge eine Quelle hinzu, die du nutzen darfst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seyrileo est un lecteur. Il ne vend ni n’inclut aucune chaîne. Ajoutez une source que vous êtes autorisé à utiliser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Seyrileo — это плеер. Он не продаёт и не содержит каналов. Добавьте источник, которым вам разрешено пользоваться."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seyrileo bir oynatıcıdır; kanal satmaz ve içermez. Kullanma yetkin olan bir kaynağı ekle."
          }
        }
      }
    },
    "Seyrileo then shows only the video on the TV and keeps the controls on this iPhone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندها يعرض Seyrileo الفيديو فقط على التلفاز ويُبقي أدوات التحكم على هذا الـ iPhone."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Seyrileo tada na televizoru prikazuje samo video, a kontrole ostaju na ovom iPhoneu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seyrileo zeigt dann nur das Video auf dem Fernseher und behält die Steuerung auf diesem iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seyrileo n’affiche alors que la vidéo sur le téléviseur et garde les commandes sur cet iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тогда Seyrileo показывает на телевизоре только видео, а управление остаётся на этом iPhone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seyrileo TV'de yalnızca videoyu gösterir; kontroller bu iPhone'da kalır."
          }
        }
      }
    },
    "Share a redacted diagnostics report with support.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شارك تقرير تشخيص منقّحًا مع الدعم."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podijelite anonimizirani dijagnostički izvještaj s podrškom."

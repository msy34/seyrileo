    "Account details come from the provider and may be incomplete.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأتي تفاصيل الحساب من المزوّد وقد تكون غير مكتملة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaci o računu dolaze od pružatelja i mogu biti nepotpuni."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kontodaten stammen vom Anbieter und können unvollständig sein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les détails du compte proviennent du fournisseur et peuvent être incomplets."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные учётной записи предоставляет поставщик, они могут быть неполными."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap bilgileri sağlayıcıdan gelir ve eksik olabilir."
          }
        }
      }
    },

    "Open a channel's TV guide and tap the bell next to an upcoming programme.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح دليل التلفاز لقناة واضغط على الجرس بجانب برنامج قادم."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorite TV vodič kanala i dodirnite zvono pored nadolazećeg programa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne das TV-Programm eines Senders und tippe auf die Glocke neben einer kommenden Sendung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez le guide TV d’une chaîne et touchez la cloche à côté d’un programme à venir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте телепрограмму канала и коснитесь колокольчика рядом с предстоящей передачей."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kanalın program rehberini aç ve yaklaşan bir programın yanındaki zile dokun."
          }
        }
      }
    },

    "Connected, but the provider reports this account as %@. Playback will probably fail.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متصل، لكن المزوّد يفيد بأن هذا الحساب %@. من المرجح أن يفشل التشغيل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povezano, ali pružatelj navodi da je ovaj račun %@. Reprodukcija vjerovatno neće uspjeti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbunden, aber der Anbieter meldet dieses Konto als %@. Die Wiedergabe wird wahrscheinlich fehlschlagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecté, mais le fournisseur indique que ce compte est %@. La lecture échouera probablement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключено, но поставщик сообщает, что учётная запись: %@. Воспроизведение, скорее всего, не удастся."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı kuruldu ancak sağlayıcı bu hesabın durumunu “%@” olarak bildiriyor. Oynatma büyük olasılıkla başarısız olacak."
          }
        }
      }
    },

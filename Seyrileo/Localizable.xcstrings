    "App Transport Security refused a plain-HTTP connection. This is not expected with the current app configuration.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض App Transport Security اتصال HTTP غير مشفّر. هذا غير متوقع مع إعدادات التطبيق الحالية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "App Transport Security je odbio nešifriranu HTTP vezu. To se ne očekuje s trenutnom konfiguracijom aplikacije."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App Transport Security hat eine unverschlüsselte HTTP-Verbindung abgelehnt. Das ist mit der aktuellen App-Konfiguration nicht zu erwarten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "App Transport Security a refusé une connexion HTTP non chiffrée. Ce n’est pas attendu avec la configuration actuelle de l’app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "App Transport Security отклонил незашифрованное HTTP-соединение. При текущей настройке приложения этого не ожидалось."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "App Transport Security düz HTTP bağlantısını reddetti. Uygulamanın mevcut yapılandırmasında bu beklenmiyor."
          }
        }
      }
    },

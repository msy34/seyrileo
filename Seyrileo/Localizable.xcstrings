    "Group channels, films and series your way. Touch and hold an item and choose “Add to collection”.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رتّب القنوات والأفلام والمسلسلات على طريقتك. المس عنصرًا مطولًا واختر «إضافة إلى مجموعة»."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Grupišite kanale, filmove i serije na svoj način. Dodirnite i držite stavku i odaberite „Dodaj u kolekciju“."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gruppiere Sender, Filme und Serien nach deinem Geschmack. Halte ein Element gedrückt und wähle „Zu Sammlung hinzufügen“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regroupez chaînes, films et séries à votre façon. Touchez longuement un élément et choisissez « Ajouter à une collection »."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Группируйте каналы, фильмы и сериалы по-своему. Нажмите и удерживайте элемент и выберите «Добавить в коллекцию»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanalları, filmleri ve dizileri kendi düzeninde grupla. Bir öğeye basılı tut ve “Koleksiyona ekle”yi seç."
          }
        }
      }
    },
    "Guide": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الدليل"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vodič"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",

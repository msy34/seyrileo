    "Removes every source from this device, including saved catalogues, favorites, history and sign-in details stored in the Keychain.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل كل المصادر من هذا الجهاز، بما في ذلك الكتالوجات المحفوظة والمفضلة والسجل وبيانات تسجيل الدخول المخزّنة في سلسلة المفاتيح."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uklanja sve izvore s ovog uređaja, uključujući sačuvane kataloge, favorite, historiju i podatke za prijavu u Keychainu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt alle Quellen von diesem Gerät, einschließlich gespeicherter Kataloge, Favoriten, Verlauf und der im Schlüsselbund gespeicherten Anmeldedaten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime toutes les sources de cet appareil, y compris les catalogues enregistrés, favoris, historique et identifiants stockés dans le trousseau."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет все источники с этого устройства, включая сохранённые каталоги, избранное, историю и данные для входа в связке ключей."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı kataloglar, favoriler, geçmiş ve Anahtar Zinciri'ndeki giriş bilgileri dahil tüm kaynakları bu cihazdan kaldırır."
          }
        }
      }
    },

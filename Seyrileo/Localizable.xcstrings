    "Sample streams are served from this phone only. An AirPlay receiver cannot reach them.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُبث البثوث التجريبية من هذا الهاتف فقط. لا يستطيع جهاز استقبال AirPlay الوصول إليها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo streamovi dolaze samo s ovog telefona. AirPlay prijemnik ih ne može dosegnuti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo-Streams kommen nur von diesem Telefon. Ein AirPlay-Empfänger kann sie nicht erreichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",

          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj naslov je %@ datoteka. Ni ugrađeni iOS plejer ni VLC ga nisu mogli reproducirati."
          }
        },
        "de": {

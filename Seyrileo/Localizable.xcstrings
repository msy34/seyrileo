            "state": "translated",
            "value": "Поставщик не указывает серий для этого сериала."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlayıcı bu dizi için bölüm listelemiyor."
          }
        }
      }
    },
    "The provider refused the sign-in": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض المزوّد تسجيل الدخول"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pružatelj je odbio prijavu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anbieter hat die Anmeldung abgelehnt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur a refusé la connexion"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставщик отклонил вход"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlayıcı girişi reddetti"
          }
        }
      }
    },
    "The provider reports this account as %@. Playback will probably fail.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفيد المزوّد بأن هذا الحساب %@. من المرجح أن يفشل التشغيل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pružatelj navodi da je ovaj račun %@. Reprodukcija vjerovatno neće uspjeti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anbieter meldet dieses Konto als %@. Die Wiedergabe wird wahrscheinlich fehlschlagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur indique que ce compte est %@. La lecture échouera probablement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставщик сообщает, что учётная запись: %@. Воспроизведение, скорее всего, не удастся."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlayıcı bu hesabın durumunu “%@” olarak bildiriyor. Oynatma büyük olasılıkla başarısız olacak."
          }
        }
      }
    },
    "The provider returned an error": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعاد المزوّد خطأ"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pružatelj je vratio grešku"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anbieter hat einen Fehler zurückgegeben"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur a renvoyé une erreur"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставщик вернул ошибку"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlayıcı bir hata döndürdü"
          }
        }
      }
    },
    "The provider returned no programmes for this channel right now.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُرجع المزوّد أي برامج لهذه القناة حاليًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pružatelj trenutno nije vratio programe za ovaj kanal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anbieter hat für diesen Sender derzeit keine Sendungen geliefert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur n’a renvoyé aucun programme pour cette chaîne pour le moment."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставщик сейчас не вернул передач для этого канала."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlayıcı şu anda bu kanal için program döndürmedi."
          }
        }
      }
    },
    "The provider says this stream does not exist right now (404). The channel may be offline.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفيد المزوّد بأن هذا البث غير موجود حاليًا (404). قد تكون القناة متوقفة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pružatelj navodi da ovaj stream trenutno ne postoji (404). Kanal je možda van emitovanja."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anbieter sagt, dass dieser Stream gerade nicht existiert (404). Der Sender ist vielleicht offline."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur indique que ce flux n’existe pas actuellement (404). La chaîne est peut-être hors ligne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставщик сообщает, что этого потока сейчас нет (404). Возможно, канал не в эфире."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlayıcı bu yayının şu anda mevcut olmadığını bildiriyor (404). Kanal kapalı olabilir."
          }
        }
      }
    },
    "The provider sent more data than Seyrileo accepts in one response.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل المزوّد بيانات أكثر مما يقبله Seyrileo في استجابة واحدة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pružatelj je poslao više podataka nego što Seyrileo prihvata u jednom odgovoru."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anbieter hat mehr Daten gesendet, als Seyrileo in einer Antwort annimmt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur a envoyé plus de données que Seyrileo n’en accepte en une réponse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставщик прислал больше данных, чем Seyrileo принимает в одном ответе."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlayıcı, Seyrileo'nun tek yanıtta kabul ettiğinden fazla veri gönderdi."
          }
        }
      }
    },
    "The provider tried to redirect to a different address or from HTTPS to HTTP. Seyrileo did not follow it so your sign-in details are not sent elsewhere.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حاول المزوّد إعادة التوجيه إلى عنوان آخر أو من HTTPS إلى HTTP. لم يتبعه Seyrileo حتى لا تُرسل بيانات تسجيل دخولك إلى مكان آخر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pružatelj je pokušao preusmjeriti na drugu adresu ili s HTTPS na HTTP. Seyrileo to nije pratio kako vaši podaci za prijavu ne bi bili poslani negdje drugo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anbieter wollte zu einer anderen Adresse oder von HTTPS zu HTTP umleiten. Seyrileo ist dem nicht gefolgt, damit deine Anmeldedaten nicht woandershin gesendet werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur a tenté de rediriger vers une autre adresse ou de HTTPS vers HTTP. Seyrileo ne l’a pas suivi afin que vos identifiants ne soient pas envoyés ailleurs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставщик пытался перенаправить на другой адрес или с HTTPS на HTTP. Seyrileo не последовал за ним, чтобы ваши данные для входа не ушли куда-то ещё."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlayıcı farklı bir adrese ya da HTTPS'den HTTP'ye yönlendirmeye çalıştı. Giriş bilgilerin başka yere gönderilmesin diye Seyrileo bu yönlendirmeyi izlemedi."
          }
        }
      }
    },
    "The provider's answer could not be read. It may be incompatible or temporarily broken.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة استجابة المزوّد. قد تكون غير متوافقة أو معطّلة مؤقتًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odgovor pružatelja nije moguće pročitati. Možda je nekompatibilan ili privremeno neispravan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Antwort des Anbieters konnte nicht gelesen werden. Sie ist vielleicht inkompatibel oder vorübergehend fehlerhaft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réponse du fournisseur est illisible. Elle est peut-être incompatible ou temporairement défaillante."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать ответ поставщика. Возможно, он несовместим или временно не работает."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlayıcının yanıtı okunamadı. Uyumsuz ya da geçici olarak bozuk olabilir."
          }
        }
      }
    },
    "The provider's server answered with an empty page instead of the video file. The file is probably missing on their side; this is not a format or app problem.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعاد خادم المزوّد صفحة فارغة بدلًا من ملف الفيديو. الملف مفقود على الأرجح من جهته؛ ليست مشكلة في الصيغة أو التطبيق."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server pružatelja vratio je praznu stranicu umjesto video datoteke. Datoteka vjerovatno nedostaje kod njih; ovo nije problem formata ni aplikacije."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server des Anbieters hat statt der Videodatei eine leere Seite geliefert. Die Datei fehlt wahrscheinlich bei ihm; es ist kein Format- oder App-Problem."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur du fournisseur a répondu par une page vide au lieu du fichier vidéo. Le fichier est probablement absent de son côté ; ce n’est pas un problème de format ni de l’app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер поставщика вернул пустую страницу вместо видеофайла. Вероятно, файл отсутствует на его стороне; это не проблема формата или приложения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlayıcının sunucusu video dosyası yerine boş bir sayfa döndürdü. Dosya büyük olasılıkla onların tarafında eksik; bu bir biçim ya da uygulama sorunu değil."
          }
        }
      }
    },
    "The purchase could not be completed. Nothing was charged.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إتمام الشراء. لم يُخصم أي مبلغ."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kupovina nije završena. Ništa nije naplaćeno."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf konnte nicht abgeschlossen werden. Es wurde nichts berechnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’achat n’a pas pu aboutir. Aucun montant n’a été débité."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка не завершена. Деньги не списаны."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alma tamamlanamadı. Ücret alınmadı."
          }
        }
      }
    },
    "The purchase is waiting for approval (for example Ask to Buy). Pro unlocks when it is approved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشراء بانتظار الموافقة (مثل «طلب الشراء»). يُفتح Pro عند الموافقة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kupovina čeka odobrenje (na primjer „Zatraži kupovinu“). Pro se otključava nakon odobrenja."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf wartet auf Genehmigung (zum Beispiel „Kaufanfrage“). Pro wird nach der Genehmigung freigeschaltet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’achat attend une approbation (par exemple « Demander l’autorisation »). Pro sera activé une fois approuvé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка ожидает одобрения (например, «Попросить купить»). Pro откроется после одобрения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alma onay bekliyor (örneğin Satın Almak İçin Sor). Onaylanınca Pro açılır."
          }
        }
      }
    },
    "The report leaves out passwords, usernames and stream addresses. Nothing is sent unless you share it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتضمن التقرير كلمات السر أو أسماء المستخدمين أو عناوين البث. لا يُرسل شيء ما لم تشاركه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvještaj ne sadrži lozinke, korisnička imena ni adrese streamova. Ništa se ne šalje dok ga sami ne podijelite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bericht enthält keine Passwörter, Benutzernamen oder Stream-Adressen. Nichts wird gesendet, solange du ihn nicht teilst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rapport exclut les mots de passe, noms d’utilisateur et adresses de flux. Rien n’est envoyé si vous ne le partagez pas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В отчёт не входят пароли, имена пользователей и адреса потоков. Ничего не отправляется, пока вы сами им не поделитесь."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapor şifreleri, kullanıcı adlarını ve yayın adreslerini içermez. Sen paylaşmadıkça hiçbir şey gönderilmez."
          }
        }
      }
    },
    "The request was cancelled.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إلغاء الطلب."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahtjev je otkazan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anfrage wurde abgebrochen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La requête a été annulée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрос был отменён."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstek iptal edildi."
          }
        }
      }
    },
    "The sample uses synthetic test patterns served from this device. No real channels.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم التجربة أنماط اختبار اصطناعية تُبث من هذا الجهاز. لا توجد قنوات حقيقية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo koristi sintetičke testne uzorke s ovog uređaja. Nema pravih kanala."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Demo nutzt synthetische Testbilder von diesem Gerät. Keine echten Sender."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La démo utilise des mires de test synthétiques servies depuis cet appareil. Aucune vraie chaîne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Демо использует синтетические тестовые таблицы с этого устройства. Никаких настоящих каналов."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Örnek deneyim bu cihazdan sunulan yapay test desenlerini kullanır. Gerçek kanal yoktur."
          }
        }
      }
    },
    "The saved catalogue could not be searched.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر البحث في الكتالوج المحفوظ."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sačuvani katalog nije moguće pretražiti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gespeicherte Katalog konnte nicht durchsucht werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de rechercher dans le catalogue enregistré."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось выполнить поиск по сохранённому каталогу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı katalogda arama yapılamadı."
          }
        }
      }
    },
    "The server answered 401 (unauthorized).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ردّ الخادم بـ 401 (غير مصرّح)."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server je odgovorio 401 (neovlašteno)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server antwortete mit 401 (nicht autorisiert)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a répondu 401 (non autorisé)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер ответил 401 (не авторизовано)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu 401 (yetkisiz) yanıtı verdi."
          }
        }
      }
    },
    "The server answered 403 (forbidden). It did not say why. Possible reasons include an inactive account, a blocked region or network, or a connection limit.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ردّ الخادم بـ 403 (محظور) دون ذكر السبب. من الأسباب المحتملة: حساب غير نشط أو منطقة أو شبكة محظورة أو حد للاتصالات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server je odgovorio 403 (zabranjeno) bez objašnjenja. Mogući razlozi: neaktivan račun, blokirana regija ili mreža ili ograničenje veza."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server antwortete mit 403 (verboten) ohne Begründung. Mögliche Gründe: inaktives Konto, gesperrte Region oder gesperrtes Netz oder ein Verbindungslimit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a répondu 403 (interdit) sans en donner la raison. Causes possibles : compte inactif, région ou réseau bloqués, ou limite de connexions."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер ответил 403 (запрещено) без объяснения. Возможные причины: неактивная учётная запись, заблокированный регион или сеть либо ограничение подключений."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu 403 (yasak) yanıtı verdi ve nedenini belirtmedi. Olası nedenler arasında etkin olmayan hesap, engellenmiş bölge veya ağ ya da bağlantı sınırı bulunur."
          }
        }
      }
    },
    "The server answered 404. The server address or its path may be wrong.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ردّ الخادم بـ 404. قد يكون عنوان الخادم أو مساره غير صحيح."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server je odgovorio 404. Adresa servera ili putanja možda nije ispravna."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server antwortete mit 404. Die Serveradresse oder ihr Pfad ist vielleicht falsch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a répondu 404. L’adresse du serveur ou son chemin est peut-être incorrect."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер ответил 404. Возможно, неверен адрес сервера или путь."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu 404 yanıtı verdi. Sunucu adresi veya yolu yanlış olabilir."
          }
        }
      }
    },
    "The server answered with HTTP status %lld.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ردّ الخادم برمز حالة HTTP %lld."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server je odgovorio HTTP statusom %lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server antwortete mit HTTP-Status %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a répondu avec le statut HTTP %lld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер ответил HTTP-статусом %lld."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu HTTP %lld durum koduyla yanıt verdi."
          }
        }
      }
    },
    "The server answered with a web page instead of data. The address may point to a website or an error page.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ردّ الخادم بصفحة ويب بدلًا من البيانات. قد يشير العنوان إلى موقع ويب أو صفحة خطأ."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server je odgovorio web-stranicom umjesto podataka. Adresa možda vodi na web-stranicu ili stranicu greške."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server antwortete mit einer Webseite statt mit Daten. Die Adresse zeigt vielleicht auf eine Website oder Fehlerseite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a répondu par une page web au lieu de données. L’adresse pointe peut-être vers un site ou une page d’erreur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер ответил веб-страницей вместо данных. Возможно, адрес ведёт на сайт или страницу ошибки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu veri yerine bir web sayfasıyla yanıt verdi. Adres bir web sitesini ya da hata sayfasını gösteriyor olabilir."
          }
        }
      }
    },
    "The server could not be reached or the connection dropped.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى الخادم أو انقطع الاتصال."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server nije dostupan ili je veza prekinuta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server war nicht erreichbar oder die Verbindung brach ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur est injoignable ou la connexion a été interrompue."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер недоступен или соединение прервалось."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucuya ulaşılamadı ya da bağlantı koptu."
          }
        }
      }
    },
    "The server name could not be found.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر العثور على اسم الخادم."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Naziv servera nije pronađen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Servername wurde nicht gefunden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom du serveur est introuvable."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя сервера не найдено."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu adı bulunamadı."
          }
        }
      }
    },
    "The server's HTTPS certificate could not be verified. Seyrileo does not bypass certificate checks.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر التحقق من شهادة HTTPS للخادم. لا يتجاوز Seyrileo فحوصات الشهادات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS certifikat servera nije moguće provjeriti. Seyrileo ne zaobilazi provjere certifikata."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das HTTPS-Zertifikat des Servers konnte nicht überprüft werden. Seyrileo umgeht keine Zertifikatsprüfungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le certificat HTTPS du serveur n’a pas pu être vérifié. Seyrileo ne contourne pas les vérifications de certificat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить HTTPS-сертификат сервера. Seyrileo не обходит проверку сертификатов."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucunun HTTPS sertifikası doğrulanamadı. Seyrileo sertifika denetimlerini atlamaz."
          }
        }
      }
    },
    "The sign-in details could not be stored in this device's Keychain.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تخزين بيانات تسجيل الدخول في سلسلة مفاتيح هذا الجهاز."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podatke za prijavu nije moguće sačuvati u Keychainu ovog uređaja."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldedaten konnten nicht im Schlüsselbund dieses Geräts gespeichert werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les identifiants n’ont pas pu être enregistrés dans le trousseau de cet appareil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить данные для входа в связке ключей устройства."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş bilgileri bu cihazın Anahtar Zinciri'ne kaydedilemedi."
          }
        }
      }
    },
    "The stream didn't start": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يبدأ البث"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stream se nije pokrenuo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Stream ist nicht gestartet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le flux n’a pas démarré"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поток не запустился"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yayın başlamadı"
          }
        }
      }
    },
    "The stream keeps stalling": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البث يتوقف باستمرار"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stream stalno zastajkuje"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Stream stockt immer wieder"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le flux se bloque sans cesse"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поток постоянно прерывается"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yayın sürekli takılıyor"
          }
        }
      }
    },
    "The stream server answered %lld. It did not say why. Possible reasons include an inactive account, a connection limit or a regional restriction.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ردّ خادم البث بـ %lld دون ذكر السبب. من الأسباب المحتملة: حساب غير نشط أو حد للاتصالات أو قيود إقليمية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server streama je odgovorio %lld bez objašnjenja. Mogući razlozi: neaktivan račun, ograničenje veza ili regionalno ograničenje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Stream-Server antwortete mit %lld ohne Begründung. Mögliche Gründe: inaktives Konto, Verbindungslimit oder regionale Einschränkung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur du flux a répondu %lld sans en donner la raison. Causes possibles : compte inactif, limite de connexions ou restriction régionale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер потока ответил %lld без объяснения. Возможные причины: неактивная учётная запись, ограничение подключений или региональное ограничение."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yayın sunucusu %lld yanıtı verdi ve nedenini belirtmedi. Olası nedenler arasında etkin olmayan hesap, bağlantı sınırı veya bölgesel kısıtlama bulunur."
          }
        }
      }
    },
    "The stream server answered with HTTP status %lld.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ردّ خادم البث برمز حالة HTTP %lld."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server streama je odgovorio HTTP statusom %lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Stream-Server antwortete mit HTTP-Status %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur du flux a répondu avec le statut HTTP %lld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер потока ответил HTTP-статусом %lld."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yayın sunucusu HTTP %lld durum koduyla yanıt verdi."
          }
        }
      }
    },
    "The stream server could not be reached.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى خادم البث."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server streama nije dostupan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Stream-Server war nicht erreichbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur du flux est injoignable."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер потока недоступен."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yayın sunucusuna ulaşılamadı."
          }
        }
      }
    },
    "The stream server delivers media in a way neither the built-in iOS player nor VLC could use.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقدّم خادم البث الوسائط بطريقة لم يتمكن مشغّل iOS المدمج ولا VLC من استخدامها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server streama isporučuje medij na način koji ni ugrađeni iOS plejer ni VLC nisu mogli koristiti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Stream-Server liefert Medien so, dass weder der integrierte iOS-Player noch VLC sie nutzen konnte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur du flux fournit le média d’une manière que ni le lecteur intégré d’iOS ni VLC ne peuvent utiliser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер потока передаёт медиа так, что ни встроенный плеер iOS, ни VLC не смогли его использовать."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yayın sunucusu medyayı, ne iOS'un yerleşik oynatıcısının ne de VLC'nin kullanabildiği bir biçimde iletiyor."
          }
        }
      }
    },
    "The stream server had a problem": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "واجه خادم البث مشكلة"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server streama je imao problem"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Stream-Server hatte ein Problem"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur du flux a rencontré un problème"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У сервера потока возникла проблема"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yayın sunucusunda bir sorun oluştu"
          }
        }
      }
    },
    "The stream server refused access. It did not say why. Possible reasons include an inactive account, a connection limit or a regional restriction.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض خادم البث الوصول دون ذكر السبب. من الأسباب المحتملة: حساب غير نشط أو حد للاتصالات أو قيود إقليمية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server streama je odbio pristup bez objašnjenja. Mogući razlozi: neaktivan račun, ograničenje veza ili regionalno ograničenje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Stream-Server hat den Zugriff ohne Begründung verweigert. Mögliche Gründe: inaktives Konto, Verbindungslimit oder regionale Einschränkung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur du flux a refusé l’accès sans en donner la raison. Causes possibles : compte inactif, limite de connexions ou restriction régionale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер потока отказал в доступе без объяснения. Возможные причины: неактивная учётная запись, ограничение подключений или региональное ограничение."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yayın sunucusu erişimi reddetti ve nedenini belirtmedi. Olası nedenler arasında etkin olmayan hesap, bağlantı sınırı veya bölgesel kısıtlama bulunur."
          }
        }
      }
    },
    "The two PINs don't match.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرمزان غير متطابقين."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dva PIN-a se ne podudaraju."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die beiden PINs stimmen nicht überein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux codes ne correspondent pas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN-коды не совпадают."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki PIN aynı değil."
          }
        }
      }
    },
    "These are your provider's details, not a Seyrileo account. They're stored only in this device's Keychain.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه بيانات المزوّد وليست حساب Seyrileo. تُخزَّن فقط في سلسلة مفاتيح هذا الجهاز."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo su podaci vašeg pružatelja, a ne Seyrileo račun. Čuvaju se samo u Keychainu ovog uređaja."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sind die Daten deines Anbieters, kein Seyrileo-Konto. Sie werden nur im Schlüsselbund dieses Geräts gespeichert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce sont les identifiants de votre fournisseur, pas un compte Seyrileo. Ils sont stockés uniquement dans le trousseau de cet appareil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это данные вашего поставщика, а не учётная запись Seyrileo. Они хранятся только в связке ключей этого устройства."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunlar sağlayıcının bilgileridir, bir Seyrileo hesabı değildir. Yalnızca bu cihazın Anahtar Zinciri'nde saklanır."
          }
        }
      }
    },
    "This category is empty.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الفئة فارغة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova kategorija je prazna."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kategorie ist leer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette catégorie est vide."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта категория пуста."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kategori boş."
          }
        }
      }
    },
    "This collection was deleted or belongs to another source.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حذف هذه المجموعة أو أنها تخص مصدرًا آخر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova kolekcija je izbrisana ili pripada drugom izvoru."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Sammlung wurde gelöscht oder gehört zu einer anderen Quelle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette collection a été supprimée ou appartient à une autre source."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта коллекция удалена или принадлежит другому источнику."

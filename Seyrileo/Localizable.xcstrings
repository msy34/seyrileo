    "For example “Evening sports”. Collections are kept only on this device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مثلًا «رياضة المساء». تبقى المجموعات على هذا الجهاز فقط."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na primjer „Večernji sport“. Kolekcije se čuvaju samo na ovom uređaju."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Beispiel „Abendsport“. Sammlungen bleiben nur auf diesem Gerät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par exemple « Sport du soir ». Les collections restent uniquement sur cet appareil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Например, «Вечерний спорт». Коллекции хранятся только на этом устройстве."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Örneğin “Akşam Spor”. Koleksiyonlar yalnızca bu cihazda tutulur."
          }
        }
      }
    },

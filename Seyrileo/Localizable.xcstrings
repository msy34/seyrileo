          "stringUnit": {
            "state": "translated",
            "value": "إخفاء كلمة السر"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sakrij lozinku"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passwort ausblenden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer le mot de passe"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрыть пароль"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şifreyi gizle"
          }
        }
      }
    },
    "If another device is watching, stop it and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كان جهاز آخر يشاهد، فأوقفه وحاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako drugi uređaj gleda, zaustavite ga i pokušajte ponovo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein anderes Gerät schaut, beende es und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un autre appareil regarde, arrêtez-le et réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если смотрит другое устройство, остановите его и повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir cihaz izliyorsa onu durdurup tekrar dene."
          }
        }
      }
    },
    "If your provider offers HLS (m3u8) output, use it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كان المزوّد يقدّم إخراج HLS (m3u8) فاستخدمه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako pružatelj nudi HLS (m3u8) izlaz, koristite ga."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn dein Anbieter HLS (m3u8) anbietet, verwende es."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si votre fournisseur propose une sortie HLS (m3u8), utilisez-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если поставщик предлагает HLS (m3u8), используйте его."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlayıcın HLS (m3u8) çıkışı sunuyorsa onu kullan."
          }
        }
      }
    },
    "It's on a locked channel. The parental PIN is needed to watch.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُعرض على قناة مقفلة. يلزم رمز الرقابة الأبوية للمشاهدة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na zaključanom je kanalu. Za gledanje je potreban roditeljski PIN."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie läuft auf einem gesperrten Sender. Zum Ansehen wird die Kindersicherungs-PIN benötigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est sur une chaîne verrouillée. Le code parental est nécessaire pour le regarder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Она идёт на заблокированном канале. Для просмотра нужен родительский PIN."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilitli bir kanalda. İzlemek için ebeveyn PIN'i gerekir."
          }
        }
      }
    },
    "Its saved catalogue, favorites and history are deleted, and its sign-in details are removed from this device's Keychain.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحذف بيانات الكتالوج والمفضلة والسجل الخاصة به، وتُزال بيانات تسجيل الدخول من سلسلة مفاتيح هذا الجهاز."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Njegov sačuvani katalog, favoriti i historija se brišu, a podaci za prijavu uklanjaju se iz Keychaina ovog uređaja."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherter Katalog, Favoriten und Verlauf werden gelöscht und die Anmeldedaten aus dem Schlüsselbund dieses Geräts entfernt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son catalogue, ses favoris et son historique sont supprimés, et ses identifiants sont retirés du trousseau de cet appareil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённый каталог, избранное и история будут удалены, а данные для входа — удалены из связки ключей этого устройства."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı kataloğu, favorileri ve geçmişi silinir; giriş bilgileri bu cihazın Anahtar Zinciri'nden kaldırılır."
          }
        }
      }
    },
